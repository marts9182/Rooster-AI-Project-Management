# Rooster AI backend — environment variables
#
# Copy this file to `.env` and fill in your secrets. The .env file is
# auto-loaded at server startup via dotenv.

# ── LLM provider ────────────────────────────────────────────────────────────
# Set to "anthropic" to wire all 7 agents to Claude. Set to "template"
# (or leave unset) to use the local SmartTemplateAdapter — no API calls,
# no cost, but agents post canned replies.
LLM_PROVIDER=template

# Anthropic API key. Required when LLM_PROVIDER=anthropic.
# Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model. claude-haiku-4-5 is the recommended default — fast,
# cheap, and sufficient for short structured comments.
# Other valid choices: claude-sonnet-4-6, claude-opus-4-7
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Image generation (Nano Banana Pro / Gemini 3 Pro Image) ─────────────────
# Required for POST /api/generate-image. Without it, the endpoint returns
# 503 and the "Generate image" panel in the task modal stays disabled.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The image model to call. Defaults to Nano Banana Pro (Gemini 3 Pro Image).
# Alternative: gemini-2.5-flash-image-preview (the original "Nano Banana" — cheaper, lower quality).
IMAGE_MODEL=gemini-3-pro-image-preview

# ── Etsy v3 — required for the etsy syncer ──────────────────────────────────
# Copy ETSY_KEYSTRING, ETSY_SHARED_SECRET, ETSY_SHOP_ID from the Python
# project's env at `projects/etsy-rooster-shop/.env.local`. Both projects
# share the same Etsy app + the same OAuth token file; the dashboard
# refreshes it in-place via ROOSTER_ETSY_TOKEN_PATH.
#
# If the token file does not exist yet, bootstrap it once with:
#   cd projects/etsy-rooster-shop && python scripts/etsy_oauth_setup.py
#
# Place the actual values in <repo-root>/.env.local (which is loaded after
# this file by loadEnv.js and never committed).
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
# Recommended: share with the Python project, e.g.
#   ROOSTER_ETSY_TOKEN_PATH=C:\Users\<you>\.etsy-rooster\token.json
# Default (when unset): data/etsy_token.json (repo-relative). ETSY_TOKEN_PATH
# is accepted as a back-compat alias.
ROOSTER_ETSY_TOKEN_PATH=
ETSY_TOKEN_PATH=

